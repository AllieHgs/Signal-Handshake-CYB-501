+    """


+
+


def __init__(self, network, ratchetBuilder):
    +        self.network = network


+        self.ratchetBuilder = ratchetBuilder
+
+


async def Register(self, user, password):
    +
    return await self.network.Register(user, password)


+
+


async def Connect(self, user, password):
    +        result = await self.network.Connect(user, password)


+
+
if result.status == Status.Success:
    +  # Build per-token ratchet instance
+            ratchet = self.ratchetBuilder.build()
+
+  # Wrap real token with ratcheted token
+            result.token = RatchetedToken(result.token, ratchet)
+
+
return result
+
+


async def Disconnect(self, token):
    +
    return await self.network.Disconnect(token)


